{
  "name": "opencode-cursor-oauth",
  "version": "0.0.9",
  "description": "OpenCode plugin that connects Cursor's API to OpenCode via OAuth, model discovery, and a local OpenAI-compatible proxy.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "bun build src/index.ts --outfile dist/index.js --target bun --external @opencode-ai/plugin && bun build src/sdk-wrapper.ts --outfile dist/sdk-wrapper.js --target bun",
    "deploy": "bun run bundle && mkdir -p \"$HOME/.config/opencode/plugins\" && cp dist/index.js \"$HOME/.config/opencode/plugins/opencode-cursor-oauth.js\" && cp dist/sdk-wrapper.js \"$HOME/.config/opencode/plugins/opencode-cursor-sdk.js\"",
    "check": "biome check src test",
    "check:fix": "biome check --fix src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:smoke": "bun test/smoke.ts",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ephraimduncan/opencode-cursor.git"
  },
  "homepage": "https://github.com/ephraimduncan/opencode-cursor#readme",
  "bugs": {
    "url": "https://github.com/ephraimduncan/opencode-cursor/issues"
  },
  "oc-plugin": [
    "server"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cursor",
    "oauth",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.37",
    "@bufbuild/protobuf": "^2.0.0",
    "@opencode-ai/plugin": "^1.2.27"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@bufbuild/buf": "^1.67.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@types/bun": "^1.3.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3"
  }
}
